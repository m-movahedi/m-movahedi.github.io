 &lt;script&gt;
 (function() {
 
 if (window.countdownIntervalLoaded) return;
 window.countdownIntervalLoaded = true;
 
 function updateCountdowns() {
 const cards = document.querySelectorAll('.conference-card');
 const now = new Date().getTime();
 
 cards.forEach(card =&gt; {
 const dateAttr = card.getAttribute('data-date');
 if (!dateAttr) return;
 
 const targetDate = new Date(dateAttr).getTime();
 if (isNaN(targetDate)) return;
 
 const distance = targetDate - now;
 
 if (distance &lt; 0) {
 const container = card.querySelector('.countdown');
 if (container &amp;&amp; !container.classList.contains('ended')) {
 container.innerHTML = "&lt;strong&gt;Event has started!&lt;/strong&gt;";
 container.classList.add('ended');
 }
 return;
 }
 
 const days = Math.floor(distance / (1000 * 60 * 60 * 24));
 const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
 const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
 const seconds = Math.floor((distance % (1000 * 60)) / 1000);
 
 const daysEl = card.querySelector('.days');
 const hoursEl = card.querySelector('.hours');
 const minutesEl = card.querySelector('.minutes');
 const secondsEl = card.querySelector('.seconds');
 
 if (daysEl &amp;&amp; hoursEl &amp;&amp; minutesEl &amp;&amp; secondsEl) {
 daysEl.innerText = String(days).padStart(2, '0');
 hoursEl.innerText = String(hours).padStart(2, '0');
 minutesEl.innerText = String(minutes).padStart(2, '0');
 secondsEl.innerText = String(seconds).padStart(2, '0');
 }
 });
 }
 
 function initCountdowns() {
 setInterval(updateCountdowns, 1000);
 updateCountdowns();
 }
 
 if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', initCountdowns);
 } else {
 initCountdowns();
 }
 })();
 &lt;/script&gt;
 
 
