    <item>
      <title>Wallpaper Manager Release 0.1</title>
      <link>http://localhost:1313/blog/wallpaper-manager/</link>
      <pubDate>Sun, 12 Jul 2026 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/blog/wallpaper-manager/</guid>
      <description>&lt;p&gt;I&amp;rsquo;m excited to introduce Wallpaper Manager, a local-first desktop app for organizing and automatically rotating your wallpapers.&lt;/p&gt;&#xA;&lt;figure&gt;&#xD;&#xA;&lt;center&gt;&#xD;&#xA;&lt;img src=&#34;http://localhost:1313/images/blog/wallpaper-manager-release01.png&#34; alt=&#34;The proposed framework&#34; /&gt;&#xD;&#xA;&lt;figcaption&gt; Wallpaper Manager Release 0.1 &lt;/figcaption&gt;&#xD;&#xA;&lt;/center&gt;&#xD;&#xA;&lt;/figure&gt;&#xD;&#xA;&lt;p&gt;Instead of limiting you to one wallpaper provider, Wallpaper Manager lets you create collections from local folders, RSS and Atom feeds, and other sources. You can combine collections into custom pools, mark images as favorites, choose their playback order, and control how frequently your background changes.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Conference Deadlines</title>
      <link>http://localhost:1313/blog/conferences/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/blog/conferences/</guid>
      <description>&lt;p&gt;Welcome to the conference countdown page! Here are the upcoming events I am looking forward to:&lt;/p&gt;&#xA;&lt;div class=&#34;countdown-container&#34;&gt;&#xA;    &#xA;      &#xA;      &lt;style&gt;&#xA;      .countdown-container {&#xA;          display: flex;&#xA;          flex-direction: column;&#xA;          gap: 2rem;&#xA;          margin: 2rem 0;&#xA;      }&#xA;    &#xA;      .conference-card {&#xA;          border: 1px solid rgba(128, 128, 128, 0.2);&#xA;          border-radius: 8px;&#xA;          padding: 1.5rem;&#xA;          box-shadow: 0 4px 6px rgba(0,0,0,0.05);&#xA;          transition: transform 0.2s ease-in-out;&#xA;      }&#xA;    &#xA;      .conference-card:hover {&#xA;          transform: translateY(-3px);&#xA;          box-shadow: 0 6px 12px rgba(0,0,0,0.1);&#xA;      }&#xA;    &#xA;      .conference-card h3 {&#xA;          margin-top: 0;&#xA;          margin-bottom: 0.5rem;&#xA;      }&#xA;    &#xA;      .conference-dates {&#xA;          font-size: 0.95rem;&#xA;          margin-bottom: 1.5rem;&#xA;          opacity: 0.8;&#xA;      }&#xA;    &#xA;      .countdown {&#xA;          display: flex;&#xA;          gap: 1.5rem;&#xA;          justify-content: flex-start;&#xA;          flex-wrap: wrap;&#xA;      }&#xA;    &#xA;      .countdown-item {&#xA;          display: flex;&#xA;          flex-direction: column;&#xA;          align-items: center;&#xA;          padding: 0.5rem;&#xA;          min-width: 65px;&#xA;      }&#xA;    &#xA;      .countdown-value {&#xA;          font-size: 2rem;&#xA;          font-weight: bold;&#xA;          line-height: 1;&#xA;          margin-bottom: 0.3rem;&#xA;          color: #007bff;&#xA;      }&#xA;    &#xA;      @media (prefers-color-scheme: dark) {&#xA;          .conference-card {&#xA;              border-color: rgba(255, 255, 255, 0.1);&#xA;              box-shadow: 0 4px 6px rgba(0,0,0,0.3);&#xA;          }&#xA;          .countdown-value {&#xA;              color: #4da3ff;&#xA;          }&#xA;      }&#xA;    &#xA;      .countdown-label {&#xA;          font-size: 0.85rem;&#xA;          text-transform: uppercase;&#xA;          letter-spacing: 1px;&#xA;          opacity: 0.8;&#xA;      }&#xA;    &#xA;      .conference-tag {&#xA;          background-color: rgba(0, 123, 255, 0.1);&#xA;          color: #007bff;&#xA;          padding: 0.2rem 0.6rem;&#xA;          border-radius: 12px;&#xA;          font-size: 0.75rem;&#xA;          font-weight: 600;&#xA;          text-transform: uppercase;&#xA;          white-space: nowrap;&#xA;      }&#xA;    &#xA;      .conference-location {&#xA;          font-size: 0.9rem;&#xA;          opacity: 0.9;&#xA;      }&#xA;      &#xA;      .conference-link {&#xA;          color: inherit;&#xA;          text-decoration: none;&#xA;          transition: color 0.2s;&#xA;      }&#xA;      &#xA;      .conference-link:hover {&#xA;          color: #007bff;&#xA;          text-decoration: underline;&#xA;      }&#xA;      &#xA;      @media (prefers-color-scheme: dark) {&#xA;          .conference-tag {&#xA;              background-color: rgba(77, 163, 255, 0.15);&#xA;              color: #4da3ff;&#xA;          }&#xA;          .conference-link:hover {&#xA;              color: #4da3ff;&#xA;          }&#xA;      }&#xA;      &lt;/style&gt;&#xA;    &#xA;      &lt;script&gt;&#xA;      (function() {&#xA;          &#xA;          if (window.countdownIntervalLoaded) return;&#xA;          window.countdownIntervalLoaded = true;&#xA;    &#xA;          function updateCountdowns() {&#xA;              const cards = document.querySelectorAll(&#39;.conference-card&#39;);&#xA;              const now = new Date().getTime();&#xA;    &#xA;              cards.forEach(card =&gt; {&#xA;                  const dateAttr = card.getAttribute(&#39;data-date&#39;);&#xA;                  if (!dateAttr) return;&#xA;                  &#xA;                  const targetDate = new Date(dateAttr).getTime();&#xA;                  if (isNaN(targetDate)) return;&#xA;                  &#xA;                  const distance = targetDate - now;&#xA;    &#xA;                  if (distance &lt; 0) {&#xA;                      const container = card.querySelector(&#39;.countdown&#39;);&#xA;                      if (container &amp;&amp; !container.classList.contains(&#39;ended&#39;)) {&#xA;                          container.innerHTML = &#34;&lt;strong&gt;Event has started!&lt;/strong&gt;&#34;;&#xA;                          container.classList.add(&#39;ended&#39;);&#xA;                      }&#xA;                      return;&#xA;                  }&#xA;    &#xA;                  const days = Math.floor(distance / (1000 * 60 * 60 * 24));&#xA;                  const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));&#xA;                  const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));&#xA;                  const seconds = Math.floor((distance % (1000 * 60)) / 1000);&#xA;    &#xA;                  const daysEl = card.querySelector(&#39;.days&#39;);&#xA;                  const hoursEl = card.querySelector(&#39;.hours&#39;);&#xA;                  const minutesEl = card.querySelector(&#39;.minutes&#39;);&#xA;                  const secondsEl = card.querySelector(&#39;.seconds&#39;);&#xA;                  &#xA;                  if (daysEl &amp;&amp; hoursEl &amp;&amp; minutesEl &amp;&amp; secondsEl) {&#xA;                      daysEl.innerText = String(days).padStart(2, &#39;0&#39;);&#xA;                      hoursEl.innerText = String(hours).padStart(2, &#39;0&#39;);&#xA;                      minutesEl.innerText = String(minutes).padStart(2, &#39;0&#39;);&#xA;                      secondsEl.innerText = String(seconds).padStart(2, &#39;0&#39;);&#xA;                  }&#xA;              });&#xA;          }&#xA;    &#xA;          function initCountdowns() {&#xA;              setInterval(updateCountdowns, 1000);&#xA;              updateCountdowns();&#xA;          }&#xA;    &#xA;          if (document.readyState === &#39;loading&#39;) {&#xA;              document.addEventListener(&#39;DOMContentLoaded&#39;, initCountdowns);&#xA;          } else {&#xA;              initCountdowns();&#xA;          }&#xA;      })();&#xA;      &lt;/script&gt;&#xA;    &#xA;    &#xA;    &lt;div class=&#34;conference-card&#34; data-date=&#34;2027-08-02T11:59:00Z&#34;&gt;&#xA;        &lt;div style=&#34;display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;&#34;&gt;&#xA;            &lt;h3&gt;&#xA;                &#xA;                &lt;a href=&#34;https://www.nationalacademies.org/trb/transportation-research-board&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34; class=&#34;conference-link&#34;&gt;TRB 107th Annual Meeting&lt;/a&gt;&#xA;                &#xA;            &lt;/h3&gt;&#xA;            &#xA;            &lt;span class=&#34;conference-tag&#34;&gt;Transportation&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;conference-dates&#34;&gt;&#xA;            Full paper submission deadline&#xA;            &#xA;            &lt;br&gt;&#xA;            &lt;span class=&#34;conference-location&#34;&gt;📍 Washington, D.C.&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;countdown&#34;&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value days&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Days&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value hours&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Hours&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value minutes&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Mins&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value seconds&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Secs&lt;/span&gt;&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &#xA;    &#xA;    &lt;div class=&#34;conference-card&#34; data-date=&#34;2026-10-16T23:59:00Z&#34;&gt;&#xA;        &lt;div style=&#34;display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;&#34;&gt;&#xA;            &lt;h3&gt;&#xA;                &#xA;                &lt;a href=&#34;https://www.asce.org/&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34; class=&#34;conference-link&#34;&gt;ASCE 2028&lt;/a&gt;&#xA;                &#xA;            &lt;/h3&gt;&#xA;            &#xA;            &lt;span class=&#34;conference-tag&#34;&gt;General Civil Engineering&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;conference-dates&#34;&gt;&#xA;            Expected call opening&#xA;            &#xA;            &lt;br&gt;&#xA;            &lt;span class=&#34;conference-location&#34;&gt;📍 Seattle, Washington&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;countdown&#34;&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value days&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Days&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value hours&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Hours&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value minutes&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Mins&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value seconds&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Secs&lt;/span&gt;&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &#xA;    &#xA;    &lt;div class=&#34;conference-card&#34; data-date=&#34;2027-05-01T23:59:00Z&#34;&gt;&#xA;        &lt;div style=&#34;display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;&#34;&gt;&#xA;            &lt;h3&gt;&#xA;                &#xA;                &lt;a href=&#34;https://cibworld.org/&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34; class=&#34;conference-link&#34;&gt;World Building Congress 2028&lt;/a&gt;&#xA;                &#xA;            &lt;/h3&gt;&#xA;            &#xA;            &lt;span class=&#34;conference-tag&#34;&gt;General Civil Engineering&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;conference-dates&#34;&gt;&#xA;            Expected call opening&#xA;            &#xA;            &lt;br&gt;&#xA;            &lt;span class=&#34;conference-location&#34;&gt;📍 Tsinghua University, Beijing&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;countdown&#34;&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value days&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Days&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value hours&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Hours&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value minutes&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Mins&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value seconds&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Secs&lt;/span&gt;&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &lt;!-- Transportation Engineering --&gt;&#xA;    &#xA;    &#xA;    &lt;div class=&#34;conference-card&#34; data-date=&#34;2027-03-01T23:59:00Z&#34;&gt;&#xA;        &lt;div style=&#34;display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;&#34;&gt;&#xA;            &lt;h3&gt;&#xA;                &#xA;                &lt;a href=&#34;https://ieee-itss.org/&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34; class=&#34;conference-link&#34;&gt;IEEE ITSC 2027&lt;/a&gt;&#xA;                &#xA;            &lt;/h3&gt;&#xA;            &#xA;            &lt;span class=&#34;conference-tag&#34;&gt;Transportation&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;conference-dates&#34;&gt;&#xA;            Intelligent Transportation Systems Conference&#xA;            &#xA;            &lt;br&gt;&#xA;            &lt;span class=&#34;conference-location&#34;&gt;📍 Boston, Massachusetts&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;countdown&#34;&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value days&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Days&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value hours&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Hours&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value minutes&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Mins&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value seconds&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Secs&lt;/span&gt;&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;    &#xA;    &#xA;    &lt;div class=&#34;conference-card&#34; data-date=&#34;2026-12-06T23:59:00Z&#34;&gt;&#xA;        &lt;div style=&#34;display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;&#34;&gt;&#xA;            &lt;h3&gt;&#xA;                &#xA;                &lt;a href=&#34;https://www.ite.org/&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34; class=&#34;conference-link&#34;&gt;ITE Annual Meeting 2027&lt;/a&gt;&#xA;                &#xA;            &lt;/h3&gt;&#xA;            &#xA;            &lt;span class=&#34;conference-tag&#34;&gt;Transportation&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;conference-dates&#34;&gt;&#xA;            Institute of Transportation Engineers&#xA;            &#xA;            &lt;br&gt;&#xA;            &lt;span class=&#34;conference-location&#34;&gt;📍 Calgary, Canada&lt;/span&gt;&#xA;            &#xA;        &lt;/div&gt;&#xA;        &lt;div class=&#34;countdown&#34;&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value days&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Days&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value hours&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Hours&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value minutes&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Mins&lt;/span&gt;&lt;/div&gt;&#xA;            &lt;div class=&#34;countdown-item&#34;&gt;&lt;span class=&#34;countdown-value seconds&#34;&gt;00&lt;/span&gt;&lt;span class=&#34;countdown-label&#34;&gt;Secs&lt;/span&gt;&lt;/div&gt;&#xA;        &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;&#xA;&lt;/div&gt;</description>
